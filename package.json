{
  "name": "mathphysics-science-island",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Interactive primary-school geometry, physics and spaceflight classroom",
  "license": "MIT",
  "scripts": {
    "build:server": "node scripts/python.mjs scripts/build_server.py",
    "build:phet": "node scripts/python.mjs scripts/build_phet_theme.py",
    "build:adapters": "node scripts/python.mjs scripts/build_display_adapters.py",
    "test:phet": "node --test tests/phet-theme.test.mjs",
    "test:phet:browser": "node tests/phet-expansion-browser.mjs",
    "start": "node scripts/python.mjs scripts/serve.py",
    "import": "node scripts/python.mjs scripts/import_upstream.py",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/smoke.mjs",
    "test:physics": "node tests/matter-library-browser.mjs",
    "test:progress:browser": "node tests/progress-browser.mjs",
    "test:clear-records": "node tests/clear-records-browser.mjs",
    "test:playground": "node tests/playground-browser.mjs",
    "test:geometry": "node --test tests/geometry.test.mjs",
    "package": "node scripts/python.mjs scripts/package.py",
    "standalone:geometry": "node scripts/python.mjs scripts/build_geometry_standalone.py",
    "test:spaceflight": "node scripts/python.mjs tests/spaceflight-browser.py",
    "build:spaceflight": "node scripts/python.mjs scripts/build_spaceflight_standalone.py",
    "build:playground": "node scripts/python.mjs scripts/build_playground_standalone.py",
    "test:classroom": "node scripts/python.mjs tests/classroom-browser.py",
    "test:classroom:inline": "node scripts/python.mjs tests/classroom-browser.py --inline",
    "build:primary": "node scripts/python.mjs scripts/build_primary_math_standalone.py",
    "test:primary": "node --test tests/primary-math.test.mjs",
    "test:primary:browser": "node scripts/python.mjs tests/primary-math-browser.py",
    "generate:questions": "node scripts/generate_questions.mjs",
    "test:questions": "node --test tests/question-bank*.test.mjs",
    "test:questions:browser": "node scripts/python.mjs tests/question-bank-browser.py"
  },
  "devDependencies": {
    "playwright": "1.56.0"
  }
}
