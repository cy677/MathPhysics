d:'capture',title:'挂索与网系捕获',text:'挂索机构接触井字形缓冲拦阻网，网系承接载荷并缓冲。'},\n {id:'secure',title:'承托与回收检查',text:'一级由网系稳定承托。回收后仍需检查与维护，不能把回收直接当作再次发射。'}\n]})"},{"start":13900,"end":13915,"text":""},{"start":13974,"end":13976,"text":"与回收"},{"start":14003,"end":14004,"text":"十"},{"start":14005,"end":14006,"text":"乙"},{"start":14013,"end":14013,"text":"与一级回收"},{"start":14023,"end":14026,"text":"十乙送"},{"start":14028,"end":14030,"text":"与回收"},{"start":14042,"end":14044,"text":"10b"},{"start":14110,"end":14110,"text":"branch:netRecovery,"},{"start":14119,"end":14122,"text":"两"},{"start":14123,"end":14126,"text":"接力送"},{"start":14128,"end":14130,"text":"；一级通过海上网系回收。对照主线与并行支线"},{"start":14131,"end":14133,"text":"认识捕获、"},{"start":14135,"end":14142,"text":"和"},{"start":14143,"end":14148,"text":"道变化"},{"start":14157,"end":14159,"text":""},{"start":14160,"end":14170,"text":"十乙"},{"start":14174,"end":14176,"text":"10B"},{"start":14177,"end":14187,"text":"为两级串联构型；一级在领航者号船上经井字形网系捕获"},{"start":14188,"end":14200,"text":"区别于猎鹰9着陆腿回收"},{"start":16920,"end":16920,"text":"Recovery','cz10b"},{"start":19787,"end":19787,"text":"神舟仍由"},{"start":19788,"end":19788,"text":"发射；"},{"start":19789,"end":19790,"text":"套用"},{"start":19791,"end":19801,"text":"十乙网系或"},{"start":19804,"end":19809,"text":""},{"start":19811,"end":19813,"text":"腿回收"},{"start":20395,"end":20397,"text":"10b"},{"start":20407,"end":20408,"text":"十"},{"start":20409,"end":20410,"text":"乙 CZ-10B"},{"start":20417,"end":20418,"text":"两"},{"start":20424,"end":20430,"text":"一级海上网系回收"},{"start":20438,"end":20444,"text":"一级使用液氧煤油，二级使用液氧甲烷"},{"start":20445,"end":20462,"text":"一级返回时由挂索机构与井字形缓冲拦阻网配合捕获，不带猎鹰9式着陆腿；顶部"},{"start":20463,"end":20485,"text":"卫星整流罩"},{"start":20497,"end":20498,"text":"10b"},{"start":20501,"end":20506,"text":"cz10bRecover"},{"start":20519,"end":20519,"text":"可回收"},{"start":20520,"end":20522,"text":""},{"start":20526,"end":20528,"text":"负责起飞和"},{"start":20529,"end":20532,"text":""},{"start":20535,"end":20535,"text":"；返回时调整姿态、减速并由网